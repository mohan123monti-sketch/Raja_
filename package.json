{
  "name": "raja-rani-online",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=@raja-rani/server",
    "dev:web": "npm run dev --workspace=@raja-rani/web",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "prisma:generate": "npm run prisma:generate --workspace=@raja-rani/server",
    "prisma:migrate": "npm run prisma:migrate --workspace=@raja-rani/server",
    "prisma:seed": "npm run prisma:seed --workspace=@raja-rani/server"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
